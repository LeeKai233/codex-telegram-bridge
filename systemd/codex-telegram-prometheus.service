# X-CodexTelegramBridge-Installer: managed
# X-CodexTelegramBridge-Installer-Version: v0.3.2
[Unit]
Description=Prometheus for Codex Telegram Bridge (rootless local monitoring)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/opt/codex-telegram-bridge/monitoring/prometheus-3.13.2/prometheus --config.file=%h/.config/codex-telegram-bridge/monitoring/prometheus/prometheus.yml --storage.tsdb.path=%h/.local/state/codex-telegram-bridge/monitoring/prometheus --storage.tsdb.retention.time=30d --storage.tsdb.retention.size=2GB --web.listen-address=127.0.0.1:9090
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.local/state/codex-telegram-bridge/monitoring/prometheus
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=default.target
